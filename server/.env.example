# ==========================================
# ShaadiSaathi Backend Configuration (.env)
# ==========================================

# Server Basics
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas / Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/shaadisaathi

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_super_secure_key_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_super_secure_key_32_chars_min
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345

# Razorpay (Payments in Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Nodemailer / SMTP (Email notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
SMTP_FROM=ShaadiSaathi <noreply@shaadisaathi.in>

# Platform Commission & Taxes
DEFAULT_PLATFORM_COMMISSION_PERCENT=10
DEFAULT_GST_PERCENT=18
RENTAL_HOLD_DURATION_MINUTES=15
